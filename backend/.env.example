# Copy to .env (git-ignored) or export in your shell. All values have local defaults.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# Allowed browser origin (the Next.js app)
FRONTEND_ORIGIN=http://localhost:3000
# JWT signing secret (falls back to secret_key_base). Generate with: bin/rails secret
DEVISE_JWT_SECRET_KEY=
# Production only
# SECRET_KEY_BASE=
# DATABASE_URL=
# Seeds
SEED_EMPLOYEES=10000
SEED_RESET=0
