# Copy to .env (git-ignored) to override the docker compose defaults. Everything is optional.

# --- docker compose (read by docker-compose.yml) ---
UI_PORT=3000              # Next.js UI on the host
API_PORT=3001             # Rails API on the host
DB_PORT=5433              # Postgres on the host (5433 avoids a local Postgres on 5432)
POSTGRES_PASSWORD=postgres
SEED_EMPLOYEES=10000      # employees created by the first-boot seed

# --- backend (Rails) — set by compose for Docker; listed here for running without Docker / deploying ---
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_URL=postgres://user:pass@host:5432/acme_salary_production   # production only
# SECRET_KEY_BASE=                     # production only (bin/rails secret)
# DEVISE_JWT_SECRET_KEY=               # JWT signing key; falls back to secret_key_base
# FRONTEND_ORIGIN=http://localhost:3000  # CORS allow-list, comma-separated
# SEED_RESET=1                         # wipe and re-seed employees on db:seed
# SEED_PASSWORD=                      # required to seed users in production (dev/test default: Password@123)

# --- frontend (Next.js) — server-only, never sent to the browser ---
# API_URL=http://localhost:3001        # compose sets http://backend:3000
